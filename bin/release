#!/usr/bin/env bash
#
# Builds the Strobe installer to share: out/make/Strobe-<version>-<arch>.dmg,
# signed with the Developer ID certificate of the keychain and notarized by Apple,
# so that it opens on any Mac without a Gatekeeper warning. And the same app as a ZIP,
# out/make/zip/darwin/<arch>/Strobe-darwin-<arch>-<version>.zip, which the installed apps update from
# (see src/main/auto_update.ts).
#
# Needs, once: the notarization credentials in the keychain (see NOTARY_PROFILE in forge.config.ts), and
# a Sentry auth token, to send the source maps of the crash reports (see webpack.plugins.ts). Create one at
# Sentry › Settings › Organization Tokens, copy it, then:
#   security add-generic-password -U -a "$USER" -s strobe-sentry-token -w "$(pbpaste)"
# (from the clipboard, so it never shows in the shell's history; security's own prompt would cut it at 128
# characters, and the token is longer)

set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP_NAME="Strobe"
NOTARY_PROFILE="strobe-notary"
SENTRY_KEYCHAIN_SERVICE="strobe-sentry-token"

case "$(uname -m)" in
  arm64) ARCH="arm64" ;;
  x86_64) ARCH="x64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

# Fail before the build when a credential is missing
security find-identity -v -p codesigning | grep -q "Developer ID Application" \
  || { echo "No Developer ID Application certificate in the keychain" >&2; exit 1; }
xcrun notarytool history --keychain-profile "$NOTARY_PROFILE" >/dev/null \
  || { echo "No notarization credentials: run the store-credentials command of forge.config.ts" >&2; exit 1; }
SENTRY_AUTH_TOKEN="$(security find-generic-password -s "$SENTRY_KEYCHAIN_SERVICE" -w 2>/dev/null)" \
  || { echo "No Sentry auth token in the keychain: see how to add one at the top of bin/release" >&2; exit 1; }
export SENTRY_AUTH_TOKEN

cd "$APP_DIR"
# A release is built from a commit, which bin/publish tags
if [ -n "$(git status --porcelain)" ]; then
  echo "Uncommitted changes: commit or stash them, then retry." >&2
  git status --short >&2
  exit 1
fi
COMMIT="$(git rev-parse HEAD)"
VERSION="$(node -p "require('./package.json').version")"
BUILT_APP="out/$APP_NAME-darwin-$ARCH/$APP_NAME.app"
DMG="out/make/$APP_NAME-$VERSION-$ARCH.dmg"
ZIP="out/make/zip/darwin/$ARCH/$APP_NAME-darwin-$ARCH-$VERSION.zip"

# Signs and notarizes the app, then signs the disk image around it, and zips it for the updates
STROBE_RELEASE=1 yarn make --targets dmg,zip

# The disk image is notarized too, so that macOS also trusts it offline
xcrun notarytool submit "$DMG" --keychain-profile "$NOTARY_PROFILE" --wait
xcrun stapler staple "$DMG"

# What Gatekeeper will check on another Mac
spctl --assess --type execute --verbose "$BUILT_APP"
spctl --assess --type open --context context:primary-signature --verbose "$DMG"
xcrun stapler validate "$DMG"
# The update: the same notarized app (the ZIP is made from it)
[ -f "$ZIP" ] || { echo "No update ZIP at $ZIP" >&2; exit 1; }

echo "$COMMIT" > "$DMG.commit"

echo "Ready to share: $APP_DIR/$DMG (publish it with bin/publish)"
