#!/usr/bin/env bash
#
# Publishes the installer built by bin/release as a GitHub release (tag v<version>),
# downloadable at a link that stays the same across versions:
#   https://github.com/NicolasMarlier/strobe/releases/latest/download/Strobe.dmg
#
# The release is tagged on the commit the installer was built from, which must be on origin/main.
# Its notes come from the Markdown file given as argument (bin/publish notes.md), followed by how to
# install; without one, just how to install.
# Needs: gh, logged in (brew install gh && gh auth login)

set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP_NAME="Strobe"

case "$(uname -m)" in
  arm64) ARCH="arm64" ;;
  x86_64) ARCH="x64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

NOTES_FILE="${1:-}"
[ -z "$NOTES_FILE" ] || [ -f "$NOTES_FILE" ] || { echo "No release notes at $NOTES_FILE" >&2; exit 1; }
NOTES_FILE="${NOTES_FILE:+$(cd "$(dirname "$NOTES_FILE")" && pwd)/$(basename "$NOTES_FILE")}"

cd "$APP_DIR"
VERSION="$(node -p "require('./package.json').version")"
TAG="v$VERSION"
DMG="out/make/$APP_NAME-$VERSION-$ARCH.dmg"

command -v gh >/dev/null || { echo "gh is missing: brew install gh && gh auth login" >&2; exit 1; }
[ -f "$DMG" ] || { echo "No installer at $DMG: run bin/release first" >&2; exit 1; }
xcrun stapler validate "$DMG" >/dev/null || { echo "$DMG is not notarized: run bin/release" >&2; exit 1; }

# The commit bin/release built from (it refuses uncommitted changes)
COMMIT="$(cat "$DMG.commit" 2>/dev/null)" || { echo "Unknown source commit for $DMG: run bin/release" >&2; exit 1; }
git fetch --quiet origin main
git merge-base --is-ancestor "$COMMIT" origin/main \
  || { echo "$COMMIT is not on origin/main: merge and push it first" >&2; exit 1; }
if git ls-remote --exit-code --tags origin "refs/tags/$TAG" >/dev/null; then
  echo "$TAG is already released: bump the version in package.json" >&2
  exit 1
fi

# Same file name for every version, for the public link
UPLOAD_DIR="$(mktemp -d)"
trap 'rm -rf "$UPLOAD_DIR"' EXIT
cp "$DMG" "$UPLOAD_DIR/$APP_NAME.dmg"

INSTALL="$APP_NAME $VERSION for Macs with Apple silicon (M1 and later). Open Strobe.dmg, then drag Strobe into Applications."
if [ -n "$NOTES_FILE" ]; then
  { cat "$NOTES_FILE"; printf '\n## Install\n\n%s\n' "$INSTALL"; } > "$UPLOAD_DIR/notes.md"
else
  echo "$INSTALL" > "$UPLOAD_DIR/notes.md"
fi

gh release create "$TAG" "$UPLOAD_DIR/$APP_NAME.dmg" \
  --repo NicolasMarlier/strobe \
  --target "$COMMIT" \
  --title "$APP_NAME $VERSION" \
  --notes-file "$UPLOAD_DIR/notes.md" \
  --latest

echo "Published: https://github.com/NicolasMarlier/strobe/releases/latest/download/$APP_NAME.dmg"
